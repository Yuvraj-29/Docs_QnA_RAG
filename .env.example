QDRANT_URL=https://your-cluster-url.example.com
QDRANT_API_KEY=your-qdrant-api-key
GROQ_API_KEY=your-groq-api-key
QDRANT_COLLECTION=docs_qna
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BACKEND=local
HF_TOKEN=your-hugging-face-token
HF_INFERENCE_PROVIDER=hf-inference
KNOWLEDGE_BASE=./knowledge_base
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_INGEST_API=false
# Set only when explicitly enabling the protected ingestion endpoint.
INGEST_API_KEY=replace-with-a-long-random-secret
